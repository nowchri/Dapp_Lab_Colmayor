# ============================================================
# PUNTOS DE CONEXION EXTERNA - FRONTEND (Next.js)
# Copiar a .env.local y reemplazar TODOS los placeholders
# con credenciales reales antes de iniciar el proyecto.
# ============================================================

# --- E1: Firebase Client SDK ---
# Accion: Crear proyecto en https://console.firebase.google.com
#   > Habilitar Authentication (Email) y Firestore
#   > Project Settings > General > Your apps > Web app > Config
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# --- E1: Firebase Admin SDK (server-side API routes) ---
# Accion: Firebase Console > Project Settings > Service Accounts
#   > Generate new private key > descargar JSON
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=your-firebase-project-id

# --- E2: Polygon Amoy Testnet RPC ---
# Accion: Crear cuenta en https://www.alchemy.com (recomendado) o https://infura.io
#   > Create App > Network: Polygon Amoy > copiar HTTPS endpoint
POLYGON_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/alch_Iz_Z3n06ZnpaR0nj-vDFW
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/alch_Iz_Z3n06ZnpaR0nj-vDFW

# --- E3: Server-side Wallet ---
# Accion: Ejecutar script generate-wallet.ts en blockchain/
#   > Copiar address y privateKey aqui
#   > Fondear con faucet: https://faucet.polygon.technology/ (seleccionar Amoy)
SERVER_PRIVATE_KEY=0xyour-private-key-here-64-hex-chars
SERVER_WALLET_ADDRESS=0xyour-wallet-address

# --- E4: Smart Contract Address ---
# Accion: Desplegar con "npm run deploy:contract" desde raiz del monorepo
#   > Copiar la direccion del output y pegarla aqui
NEXT_PUBLIC_CONTRACT_ADDRESS=0xyour-deployed-contract-address

# --- E5: Servicio de Correos ---
# Accion: Crear cuenta en https://sendgrid.com (free tier: 100/dia)
#   > Settings > API Keys > Create API Key > Full Access
# O usar https://resend.com como alternativa
SENDGRID_API_KEY=
# RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=

# --- Emails para notificaciones (RF-14) ---
# Accion: Confirmar emails reales con administracion IUCMC
ADMIN_EMAIL=
DECANATURA_EMAIL=

# --- Regex correo institucional (RF-18) ---
# DECISION PENDIENTE: Validar dominio exacto con IUCMC
NEXT_PUBLIC_EMAIL_REGEX=^[a-zA-Z0-9._%+-]+@unimayor\.edu\.co$

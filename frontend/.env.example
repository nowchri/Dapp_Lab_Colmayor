# ============================================================
# Plantilla de variables de entorno — DApp Lab IUCMC
# Copiar a frontend/.env y completar:
#   cp frontend/.env.example frontend/.env
# frontend/.env NO se versiona (.gitignore).
# ============================================================

# --- Base de datos (PostgreSQL) ---
# Neon → Project → Connection string → pestaña "Pooled connection".
# Importante: usar el host con "-pooler" y ?sslmode=require
# (node-postgres no soporta channel_binding).
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Correo saliente (Gmail SMTP con contraseña de aplicación) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=cuenta@unimayor.edu.co
SMTP_PASS=app-password-de-16-caracteres
EMAIL_FROM=cuenta@unimayor.edu.co
ADMIN_EMAIL=labadministrador@gmail.com
DECANATURA_EMAIL=labadministrador@gmail.com

# --- Validación de correo institucional (RF-18) ---
NEXT_PUBLIC_EMAIL_REGEX=^[a-zA-Z0-9._%+-]+@unimayor\.edu\.co$

# --- Web Push / PWA (VAPID) ---
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Cron de recordatorios (header x-cron-secret) ---
CRON_SECRET=

# --- Respaldo on-chain (Polygon Amoy) — solo para anclaje manual ---
POLYGON_RPC_URL=
NEXT_PUBLIC_POLYGON_RPC_URL=
SERVER_PRIVATE_KEY=
SERVER_WALLET_ADDRESS=
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0E362CF2d81538EBa168F92CB382174d01ab25c1
